{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uade-documentos",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGINS": "https://laslabcritical.github.io",
    "UPLOADS_ENABLED": "true",
    "GITHUB_REPOSITORY": "laslabcritical/uade.form",
    "GITHUB_BRANCH": "main"
  },
  "ratelimits": [
    { "name": "UPLOAD_LIMITER", "namespace_id": "92301", "simple": { "limit": 5, "period": 60 } },
    { "name": "READ_LIMITER", "namespace_id": "92302", "simple": { "limit": 120, "period": 60 } }
  ]
}
